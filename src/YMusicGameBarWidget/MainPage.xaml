<Page
    x:Class="YMusicGameBarWidget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Spacing="10">
            <FontIcon Glyph="&#xE8B5;" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="Yandex Music Widget" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock
                Text="Этот виджет работает внутри Xbox Game Bar."
                TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <TextBlock
                Text="Откройте Game Bar (Win + G), нажмите «Виджеты» и добавьте «Yandex Music». Включите трек в приложении Яндекс Музыки, чтобы увидеть обложку и управление."
                TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
