<Page
    x:Class="YMusicGameBarWidget.Views.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:YMusicGameBarWidget.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    RequestedTheme="Dark">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Background="#FF1E1E1E">
        <Viewbox Stretch="Uniform">
            <Grid Width="360" Height="180" Padding="12,10,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

        <!-- Track info -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="52" Height="52" CornerRadius="8" Background="#FF2E2E2E"
                VerticalAlignment="Center" BorderThickness="1" BorderBrush="#33FFFFFF">
                <Grid>
                    <FontIcon
                        Glyph="&#xE8B5;" Foreground="#55FFFFFF" FontSize="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasArtwork, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        IsHitTestVisible="False" />
                    <Image
                        x:Name="ArtImage"
                        Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.HasArtwork, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="3">
                <TextBlock
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    FontSize="15" FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                    FontSize="12" Foreground="#AAFFFFFF"
                    TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <!-- Transport controls -->
        <StackPanel
            Grid.Row="1" Orientation="Horizontal" Spacing="6"
            HorizontalAlignment="Center" Margin="0,10,0,6">
            <Button
                x:Name="PrevButton" Click="OnPrev" Width="40" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                IsEnabled="{x:Bind ViewModel.CanPrevious, Mode=OneWay}"
                ToolTipService.ToolTip="Предыдущий трек">
                <FontIcon Glyph="&#xE892;" FontSize="15" />
            </Button>
            <Button
                x:Name="RewindButton" Click="OnSeekBack5" Width="40" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="Назад на 5 секунд">
                <TextBlock Text="-5" FontSize="13" FontWeight="SemiBold" />
            </Button>
            <Button
                x:Name="PlayButton" Click="OnPlayPause" Width="44" Height="44" Padding="0"
                Background="#22FFFFFF" BorderThickness="0" CornerRadius="22"
                IsEnabled="{x:Bind ViewModel.CanPlayPause, Mode=OneWay}"
                ToolTipService.ToolTip="Играть / Пауза">
                <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="18" />
            </Button>
            <Button
                x:Name="ForwardButton" Click="OnSeekFwd5" Width="40" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                ToolTipService.ToolTip="Вперёд на 5 секунд">
                <TextBlock Text="+5" FontSize="13" FontWeight="SemiBold" />
            </Button>
            <Button
                x:Name="NextButton" Click="OnNext" Width="40" Height="36" Padding="0"
                Background="Transparent" BorderThickness="0"
                IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}"
                ToolTipService.ToolTip="Следующий трек">
                <FontIcon Glyph="&#xE893;" FontSize="15" />
            </Button>
        </StackPanel>

        <!-- Seek bar + times -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="ProgressGrid"
                Grid.Row="0" Height="24" Background="Transparent"
                Padding="0"
                Tapped="OnProgressTapped"
                PointerMoved="OnProgressPointerMoved"
                PointerExited="OnProgressPointerExited">
                <ProgressBar
                    x:Name="ProgressBar" Height="4" Maximum="1"
                    VerticalAlignment="Center"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <Border
                    x:Name="SeekHint"
                    Background="#CC000000" Padding="5,2" CornerRadius="3"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="SeekHintText" Text="0:00" FontSize="10" Foreground="White" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" FontSize="10" Foreground="#AAFFFFFF" />
                <TextBlock
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                    FontSize="10" Foreground="#AAFFFFFF" HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
    </Viewbox>
    </Grid>
</Page>
